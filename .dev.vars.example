# 方案 A（推荐）：Web3Forms —— 只需一个 Access Key（服务端密钥，勿提交仓库）
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key
# WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit

# 方案 B：Resend
INQUIRY_TO_EMAIL=your-confirmed-inbox@example.com
MAIL_API_KEY=re_your_resend_key
MAIL_FROM=KALOZEN Website <inquiry@your-domain.com>
MAIL_API_ENDPOINT=https://api.resend.com/emails
INQUIRY_ADMIN_TOKEN=your-long-random-admin-token
# 或改用自建转发：
# INQUIRY_WEBHOOK_URL=https://your-server.example.com/inquiry
